# Put this file at: .github/workflows/extra-update.yml
# Runs one hour AFTER your existing daily hackathon workflow.
name: Daily jobs update and link check

on:
  schedule:
    - cron: '30 1 * * *'     # 07:00 AM IST every day
  workflow_dispatch:          # lets you press "Run workflow" manually

permissions:
  contents: write

concurrency:
  group: extra-update
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Update jobs and check links
        env:
          ADZUNA_APP_ID: ${{ secrets.ADZUNA_APP_ID }}
          ADZUNA_APP_KEY: ${{ secrets.ADZUNA_APP_KEY }}
        run: python scripts/update_extra.py

      - name: Save changes
        run: |
          git config user.name "skillbridge-bot"
          git config user.email "skillbridge-bot@users.noreply.github.com"
          git add listings.json update-status.json link-report.json
          if git diff --cached --quiet; then
            echo "Nothing changed"
          else
            git commit -m "Daily jobs update $(date -u +%F)"
            git pull --rebase
            git push
          fi
